---
// src/layouts/Layout.astro
import "@/styles/global.css";
import { locales, type Locale } from "@/i18n/config";
import { localizePath, switchLocalePath } from "@/i18n/utils";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ScrollTop from "@/components/ScrollTop.astro";

// TypeScript interface defining component props
interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  ogImage?: string;
  hideNav?: boolean; // Controls header visibility
  hideFooter?: boolean; // Controls footer visibility
  noIndex?: boolean; // Exclude certain pages from Google spiders
}

// Destructure props with sensible defaults
const {
  title,
  description = "Creative thinking, visual craft and technology speaking the same language.",
  locale = "en",
  ogImage = "/images/og/aoset-ogg-website.png",
  hideNav = false,
  hideFooter = false,
  noIndex = false,
} = Astro.props;

// Determine fallback base URL for canonical and OG meta tags
const siteBase = Astro.site ?? "https://aosetvisuals.com";

// Construct canonical and absolute OpenGraph image URLs
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const absoluteOgImage = new URL(ogImage, siteBase).toString();
---

<!doctype html>
<html lang={locale} class="font-sans">
  <head>
    <!-- Character Set & Viewport -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />
    <!-- Primary Metadata -->
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Preload Self-Hosted Variable Font for Performance -->
    <link
      rel="preload"
      href="/fonts/elms-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- PWA & Web App Icons -->
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />

    <link
      rel="apple-touch-icon"
      href="/icons/apple-touch-icon.png"
      sizes="180x180"
    />

    <link rel="manifest" href="/manifest.webmanifest" />

    <meta name="theme-color" content="#0F1419" />

    <meta name="apple-mobile-web-app-capable" content="yes" />

    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AOSET Visuals" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AOSET Visuals" />
    <meta property="og:locale" content={locale === "es" ? "es_US" : "en_US"} />

    <!-- Twitter / X Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content="AOSET Visuals" />

    <!-- Multi-language Alternates (i18n) -->
    {
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(switchLocalePath(Astro.url, l), siteBase)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizePath("en", "/"), siteBase)}
    />

    <!-- Synchronous Theme Switcher Script (Prevents FOUC on page load) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("aoset-theme");
          const preferred = window.matchMedia("(prefers-color-scheme: dark)")
            .matches
            ? "dark"
            : "light";

          const theme = stored ?? preferred;
          document.documentElement.setAttribute("data-theme", theme);
        } catch (_) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>

  <body class="bg-surface text-text min-h-dvh flex flex-col font-sans">
    <!-- Render Header conditionally if hideNav is false -->
    {!hideNav && <Header locale={locale} />}

    <!-- Main Content Area -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Render Footer conditionally if hideFooter is false -->
    {!hideFooter && <Footer locale={locale} />}

    <ScrollTop />
  </body>
</html>
