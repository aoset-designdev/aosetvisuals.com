---
// src/pages/[locale]/about.astro
import Layout from '@/layouts/Layout.astro';
import AboutBanner from '@/components/AboutBanner.astro';
import OurProcess from '@/components/OurProcess.astro';
import QualityGuarantee from '@/components/QualityGuarantee.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { getLocalePaths, useTranslations } from '@/i18n/utils';
import { locales, type Locale } from '@/i18n/config';

// REQUIRED: In Cloudflare SSR mode, static pages using getStaticPaths() 
// must explicitly set `prerender = true` to be generated at build time.
export const prerender = true;

export function getStaticPaths() {
  return getLocalePaths();
}

// Safely extract and validate the locale route parameter
const rawLocale = Astro.params.locale;
const locale: Locale = locales.includes(rawLocale as Locale) 
  ? (rawLocale as Locale) 
  : 'en';

const t = useTranslations(locale);

// Strip HTML tags from translation body text for clean meta description metadata
const metaDescription = t.about.hero.body.replace(/<[^>]*>/g, '');
---

<Layout
  title={`${t.about.hero.heading} — AOSET`}
  locale={locale}
  description={metaDescription}
>
  <!-- Hero Section -->
  <section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:pt-24">
    <!-- Using Tailwind CSS v4 Theme Utility `text-text` -->
    <h1 class="text-3xl font-semibold leading-snug text-text sm:text-4xl">
      {t.about.hero.heading}
    </h1>
    <!-- Using Tailwind CSS v4 Theme Utility with Opacity Modifier `text-text/70` -->
    <p class="mt-6 text-base leading-loose text-text/70">
      {t.about.hero.body}
    </p>
  </section>

  <!-- Visual Banner -->
  <AboutBanner locale={locale} />

  <!-- Content Sections -->
  <OurProcess locale={locale} />
  <QualityGuarantee locale={locale} />
  <CtaBanner locale={locale} section="about" />
</Layout>