---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Closing from '../../components/Closing.astro';

import { getLocalePaths } from '../../i18n/utils';

import type { Locale } from '../../i18n/config';

export function getStaticPaths() {
  return getLocalePaths();
}

const { locale } = Astro.params as {
  locale: Locale;
};

const metaDescription =
  "Creative thinking, visual craft and technology speaking the same language.";
---

<Layout
  title="AOSET Visuals | Elevating the Visible Layer."
  locale={locale}
  description={metaDescription}
  ogImage="/images/ogg/aoset-ogg-website.png"
>
  <Hero locale={locale} />
  <About locale={locale} />
  <Closing locale={locale} />
</Layout>