---
// src/pages/[locale]/work.astro

/**
 * Selected Work
 *
 * Localized portfolio index route.
 *
 * Responsibilities:
 * - Static route generation
 * - Locale resolution
 * - SEO metadata
 * - Project data composition
 * - Project grid composition
 *
 * Individual visual sections are delegated to components.
 */

import Layout from '@/layouts/Layout.astro';

import WorkIntro from '@/components/work/WorkIntro.astro';
import ProjectCard from '@/components/work/ProjectCard.astro';

import {
  getLocalePaths,
  localizePath,
  useTranslations,
} from '@/i18n/utils';

import {
  locales,
  type Locale,
} from '@/i18n/config';

/* ============================================================
   PROJECT ASSETS
   ============================================================ */

import jcoHero from '@/assets/projects/jco-estate-renovations/hero.webp';
import jdHero from '@/assets/projects/jd-good-corp/hero.webp';
import seabizaHero from '@/assets/projects/seabiza/hero.webp';
import campaignHero from '@/assets/projects/campaign/hero.webp';

/* ============================================================
   STATIC GENERATION
   ============================================================ */

export const prerender = true;

export function getStaticPaths() {
  return getLocalePaths();
}

/* ============================================================
   LOCALE
   ============================================================ */

const rawLocale = Astro.params.locale;

const locale: Locale = locales.includes(rawLocale as Locale)
  ? (rawLocale as Locale)
  : 'en';

const t = useTranslations(locale);

/* ============================================================
   SEO
   ============================================================ */

const metaDescription = t.work.intro;

/* ============================================================
   PROJECTS
   ------------------------------------------------------------
   Content comes from the same localized project data already
   used by the homepage bento.

   This data remains local to the route for now. It can later
   move into a shared build-time project registry without
   changing the presentation components.
   ============================================================ */

const projects = [
  {
    slug: 'jco-estate-renovations',
    image: jcoHero,
    alt: t.hero.projects.jco.alt,
    label: t.hero.projects.jco.label,
    title: t.hero.projects.jco.title,
    subtitle: t.hero.projects.jco.subtitle,
    meta: t.hero.projects.jco.meta,
  },

  {
    slug: 'email-campaign',
    image: campaignHero,
    alt: t.hero.projects.campaign.alt,
    label: t.hero.projects.campaign.label,
    title: t.hero.projects.campaign.title,
    subtitle: '',
    meta: t.hero.projects.campaign.description,
  },

  {
    slug: 'seabiza',
    image: seabizaHero,
    alt: t.hero.projects.seabiza.alt,
    label: 'Brand Concept',
    title: t.hero.projects.seabiza.title,
    subtitle: t.hero.projects.seabiza.subtitle,
    meta: t.hero.projects.seabiza.meta,
  },

  {
    slug: 'jd-good-corp',
    image: jdHero,
    alt: t.hero.projects.jd.alt,
    label: 'Brand Identity',
    title: t.hero.projects.jd.title,
    subtitle: t.hero.projects.jd.subtitle,
    meta: t.hero.projects.jd.meta,
  },
];
---

<Layout
  title={`${t.work.eyebrow} — AOSET`}
  locale={locale}
  description={metaDescription}
>
  <main class="bg-midnight">

    <!-- =====================================================
         PAGE INTRO
         ===================================================== -->

    <WorkIntro
      eyebrow={t.work.eyebrow}
      heading={t.work.heading}
      intro={t.work.intro}
    />

    <!-- =====================================================
         PROJECT GRID
         ===================================================== -->

    <section
      class="
        mx-auto
        max-w-7xl
        px-4
        pb-24
        sm:px-6
        lg:px-8
        lg:pb-32
      "
      aria-label={t.work.eyebrow}
    >
      <div
        class="
          grid
          grid-cols-1
          gap-4
          md:grid-cols-2
        "
      >
        {
          projects.map((project, index) => (
            <ProjectCard
              href={localizePath(
                locale,
                `/work/${project.slug}`,
              )}
              image={project.image}
              alt={project.alt}
              label={project.label}
              title={project.title}
              subtitle={project.subtitle}
              meta={project.meta}
              viewProject={t.work.viewProject}
              eager={index < 2}
            />
          ))
        }
      </div>
    </section>

  </main>
</Layout>