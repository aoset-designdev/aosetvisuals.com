---
// src/pages/[locale]/work.astro

/**
 * Selected Work
 *
 * Localized portfolio index route.
 *
 * Responsibilities:
 * - Static route generation
 * - Locale resolution
 * - SEO metadata
 * - Project registry composition
 * - Project grid composition
 *
 * Individual visual sections are delegated to components.
 */

import Layout from '@/layouts/Layout.astro';

import WorkIntro from '@/components/work/WorkIntro.astro';
import ProjectCard from '@/components/work/ProjectCard.astro';

import { projects } from '@/data/projects';

import {
  getLocalePaths,
  localizePath,
  useTranslations,
} from '@/i18n/utils';

import {
  locales,
  type Locale,
} from '@/i18n/config';

/* ============================================================
   STATIC GENERATION
   ============================================================ */

export const prerender = true;

export function getStaticPaths() {
  return getLocalePaths();
}

/* ============================================================
   LOCALE
   ============================================================ */

const rawLocale = Astro.params.locale;

const locale: Locale = locales.includes(rawLocale as Locale)
  ? (rawLocale as Locale)
  : 'en';

const t = useTranslations(locale);

/* ============================================================
   SEO
   ============================================================ */

const metaDescription = t.work.intro;

/* ============================================================
   PROJECTS
   ============================================================ */

const publishedProjects = projects
  .filter((project) => project.status === 'published')
  .sort((a, b) => a.order - b.order);

---

<Layout
  title={`${t.work.eyebrow} — AOSET`}
  locale={locale}
  description={metaDescription}
>
  <main class="bg-surface">

    <!-- =====================================================
         PAGE INTRO
         ===================================================== -->

    <WorkIntro
      eyebrow={t.work.eyebrow}
      heading={t.work.heading}
      intro={t.work.intro}
    />

    <!-- =====================================================
         PROJECT GRID
         ===================================================== -->

    <section
      class="
        mx-auto
        max-w-7xl
        px-4
        pb-24
        sm:px-6
        lg:px-8
        lg:pb-32
      "
      aria-label={t.work.eyebrow}
    >
      <div
        class="
          grid
          grid-cols-1
          gap-4
          md:grid-cols-2
        "
      >
        {
          publishedProjects.map((project, index) => {
            const content = (() => {
              switch (project.translationKey) {
                case 'jco':
                  return {
                    alt: t.hero.projects.jco.alt,
                    label:
                      project.labelOverride ??
                      t.hero.projects.jco.label,
                    title: t.hero.projects.jco.title,
                    subtitle:
                      project.subtitleOverride ??
                      t.hero.projects.jco.subtitle,
                    meta: t.hero.projects.jco.meta,
                  };

                case 'campaign':
                  return {
                    alt: t.hero.projects.campaign.alt,
                    label:
                      project.labelOverride ??
                      t.hero.projects.campaign.label,
                    title: t.hero.projects.campaign.title,
                    subtitle:
                      project.subtitleOverride ?? '',
                    meta: t.hero.projects.campaign.description,
                  };

                case 'seabiza':
                  return {
                    alt: t.hero.projects.seabiza.alt,
                    label:
                      project.labelOverride ??
                      'Brand Concept',
                    title: t.hero.projects.seabiza.title,
                    subtitle:
                      project.subtitleOverride ??
                      t.hero.projects.seabiza.subtitle,
                    meta: t.hero.projects.seabiza.meta,
                  };

                case 'jd':
                  return {
                    alt: t.hero.projects.jd.alt,
                    label:
                      project.labelOverride ??
                      'Brand Identity',
                    title: t.hero.projects.jd.title,
                    subtitle:
                      project.subtitleOverride ??
                      t.hero.projects.jd.subtitle,
                    meta: t.hero.projects.jd.meta,
                  };
              }
            })();

            return (
              <ProjectCard
                href={localizePath(
                  locale,
                  `/work/${project.slug}`,
                )}
                image={project.image}
                alt={content.alt}
                label={content.label}
                title={content.title}
                subtitle={content.subtitle}
                meta={content.meta}
                viewProject={t.work.viewProject}
                eager={index < 2}
              />
            );
          })
        }
      </div>
    </section>

  </main>
</Layout>