---
// src/pages/[locale]/services.astro
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getLocalePaths, useTranslations, localizePath } from '@/i18n/utils';
import { locales, type Locale } from '@/i18n/config';

// Pre-render statically on Cloudflare Pages/SSR mode
export const prerender = true;

export function getStaticPaths() {
  return getLocalePaths();
}

// Safely extract and validate locale route parameter
const rawLocale = Astro.params.locale;
const locale: Locale = locales.includes(rawLocale as Locale) 
  ? (rawLocale as Locale) 
  : 'en';

const t = useTranslations(locale);

// Strip potential HTML tags from subtitle for clean meta description snippet
const metaDescription = t.services.subtitle.replace(/<[^>]*>/g, '');

// Automatically match local service images if present in src/assets/services/
const serviceImages = import.meta.glob<{ default: ImageMetadata }>(
  '@/assets/services/*.{jpeg,jpg,png,webp,avif}',
  { eager: true }
);

// Map images by array list
const imageList = Object.values(serviceImages).map((mod) => mod.default);

// AOSET palette fallback gradients
const bgColors = [
  'from-aoset-blue to-slate',
  'from-slate to-midnight',
  'from-midnight to-slate',
  'from-slate to-aoset-blue',
  'from-aoset-blue to-midnight',
  'from-midnight to-aoset-blue',
];
---

<Layout title={`${t.services.heading} — AOSET`} locale={locale} description={metaDescription}>

  <!-- Hero Section -->
  <section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:pt-24">
    <h1 class="text-3xl font-semibold leading-snug text-text sm:text-4xl">
      {t.services.heading}
    </h1>

    <p class="mt-4 text-base text-text-muted">
      {t.services.subtitle}
    </p>
  </section>

  <!-- Services Grid -->
  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {t.services.items.map((service, index) => {
        // Safe color rotation even if items > bgColors.length
        const bgGradient = bgColors[index % bgColors.length];
        const cardImage = imageList[index];

        return (
          <a
            href={localizePath(locale, service.href)}
            class={`group relative isolate flex aspect-4/3 flex-col items-center justify-center overflow-hidden rounded-lg p-8 text-center bg-linear-to-b ${bgGradient} focus-visible:outline-2 focus-visible:outline-offset-2`}
          >
            <!-- Render optimized image if present, else fallback to gradient background -->
            {cardImage && (
              <Image
                src={cardImage}
                alt={service.title}
                class="absolute inset-0 -z-20 size-full object-cover transition-transform duration-500 group-hover:scale-105"
                widths={[315, 630]}
                sizes="(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw"
                format="avif"
                quality={85}
              />
            )}

            <!-- Overlay for text readability -->
            <div 
              class="absolute inset-0 -z-10 bg-black/40 transition-colors duration-300 group-hover:bg-black/60" 
              aria-hidden="true" 
            />

            <h3 class="text-2xl font-semibold text-white drop-shadow-xs">
              {service.title}
            </h3>

            <!-- Visible on mobile by default; fades in on desktop hover -->
            <p class="mt-3 text-sm leading-relaxed text-white/90 opacity-90 transition-opacity duration-300 sm:opacity-0 sm:group-hover:opacity-100">
              {service.description}
            </p>
          </a>
        );
      })}
    </div>
  </section>

</Layout>