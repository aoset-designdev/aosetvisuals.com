---
// src/pages/[locale]/contact.astro
import Layout from '@/layouts/Layout.astro';
import ContactSection from '@/components/ContactSection.astro';
import { getLocalePaths, useTranslations } from '@/i18n/utils';
import { locales, type Locale } from '@/i18n/config';

// REQUIRED: Static page in Cloudflare SSR mode using getStaticPaths()
export const prerender = true;

export function getStaticPaths() {
  return getLocalePaths();
}

// Safely extract and validate locale parameter
const rawLocale = Astro.params.locale;
const locale: Locale = locales.includes(rawLocale as Locale) 
  ? (rawLocale as Locale) 
  : 'en';

const t = useTranslations(locale);

// Strip HTML tags from translation string for clean meta description snippet
const metaDescription = t.contact.intro.replace(/<[^>]*>/g, '');

// Add your real Google Maps Embed URL here or leave empty to hide
const GOOGLE_MAPS_EMBED_URL = ""; 
---

<Layout
  title={`${t.contact.heading || 'Contact'} — AOSET`}
  locale={locale}
  description={metaDescription}
>
  <ContactSection locale={locale} />

  {GOOGLE_MAPS_EMBED_URL && (
    <section class="h-112.5 w-full">
      <iframe
        title="AOSET office location"
        src={GOOGLE_MAPS_EMBED_URL}
        width="100%"
        height="100%"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="block border-none"
      />
    </section>
  )}
</Layout>