      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .connect-cover {
      display: none;
    }

    .connect-background,
    .connect-interface {
      animation: none;
      transform: none;
      opacity: 1;
      will-change: auto;
    }

    #message-dialog,
    #message-dialog::backdrop {
      transition: none;
    }

    #message-dialog {
