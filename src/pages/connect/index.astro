---
// src/pages/connect/index.astro
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connect | AOSET Visuals</title>
  </head>
  <body>
    <main class="container">
      <section class="connect-card">
        <h1>AOSET Visuals</h1>
        <p>Creative Design & Visual Production Studio</p>

        <!-- Action Buttons Grid -->
        <div class="action-buttons">
          <!-- 1. Save Contact Button -->
          <a
            href="/api/connect"
            id="save-vcard-link"
            class="btn btn-primary"
            aria-label="Save contact card for AOSET Visuals"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M19 8v6M22 11h-6"></path>
            </svg>
            <span>Save Contact</span>
          </a>

          <!-- 2. WhatsApp Business Button -->
          <a
            href="https://wa.me/13054821642?text=Hello%20AOSET%20Visuals%2C%20I'd%20like%20to%20get%20in%20touch!"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp"
            aria-label="Chat with AOSET Visuals on WhatsApp"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            <span>WhatsApp</span>
          </a>

          <!-- 3. Direct Call Button -->
          <a
            href="tel:+13054821642"
            class="btn btn-call"
            aria-label="Call AOSET Visuals directly"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>Call Us</span>
          </a>
        </div>

        <!-- Contact Form -->
        <form id="connect-form" class="connect-form">
          <div class="form-group">
            <input type="text" name="firstName" placeholder="First Name *" required />
            <input type="text" name="lastName" placeholder="Last Name *" required />
          </div>
          <div class="form-group">
            <input type="email" name="email" placeholder="Email Address *" required />
            <input type="tel" name="phone" placeholder="Phone Number" />
          </div>
          <div class="form-group">
            <input type="text" name="subject" placeholder="Subject" />
          </div>
          <div class="form-group">
            <textarea name="message" placeholder="Your Message" rows="4"></textarea>
          </div>
          <button type="submit" class="btn btn-secondary">Send Message</button>
          <p id="form-status" class="form-status" aria-live="polite"></p>
        </form>
      </section>
    </main>

    <script>
      // 1. Non-Safari iOS Fallback Handler
      const vcardLink = document.getElementById('save-vcard-link') as HTMLAnchorElement;

      if (vcardLink) {
        vcardLink.addEventListener('click', async (e) => {
          const userAgent = window.navigator.userAgent;
          const isIOS = /iPhone|iPad|iPod/i.test(userAgent);
          const isSafari = /^((?!chrome|android|crios|fxios|opera|opios).)*safari/i.test(userAgent);

          if (isIOS && !isSafari) {
            e.preventDefault();

            try {
              const response = await fetch('/api/connect');
              if (!response.ok) throw new Error('vCard fetch failed');
              const vcardText = await response.text();
              window.location.href = 'data:text/vcard;charset=utf-8,' + encodeURIComponent(vcardText);
            } catch (err) {
              console.error('Failed to load vCard:', err);
            }
          }
        });
      }

      // 2. Form Submission Handler
      const form = document.getElementById('connect-form') as HTMLFormElement;
      const statusText = document.getElementById('form-status') as HTMLParagraphElement;

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          statusText.textContent = 'Sending...';

          const formData = new FormData(form);
          const payload = Object.fromEntries(formData.entries());

          try {
            const res = await fetch('/api/connect', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            const data = await res.json();

            if (res.ok && data.success) {
              statusText.textContent = 'Message sent successfully!';
              form.reset();
            } else {
              statusText.textContent = data.error || 'Failed to send message.';
            }
          } catch {
            statusText.textContent = 'An unexpected error occurred.';
          }
        });
      }
    </script>
  </body>
</html>