---
// src/pages/connect/index.astro
import Layout from '@/layouts/Layout.astro';

// Force Server-Side Rendering (SSR) for Cloudflare Workers request context
export const prerender = false;
---

<Layout
  title="Connect | AOSET Visuals"
  hideNav={true}
  hideFooter={true}
>
  <!-- Main viewport container -->
  <main
    class="relative flex min-h-dvh w-full items-center justify-center overflow-hidden bg-midnight p-3 text-white sm:p-5"
  >
    <!-- Initial dark cover -->
    <div
      class="connect-cover pointer-events-none fixed inset-0 z-50 bg-midnight"
      aria-hidden="true"
    ></div>

    <!-- Framed Connect card -->
    <section
      class="relative min-h-[calc(100dvh-1.5rem)] w-full max-w-md overflow-hidden rounded-2xl border border-white/10 bg-midnight sm:min-h-[calc(100dvh-2.5rem)]"
    >
      <!-- Animated background layer -->
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden"
        aria-hidden="true"
      >
        <img
          src="/images/background_connect.webp"
          alt=""
          width="1080"
          height="1920"
          loading="eager"
          decoding="async"
          class="connect-background absolute inset-0 h-full w-full object-cover"
        />

        <!-- Readability overlay -->
        <div
          class="absolute inset-0 bg-linear-to-b from-midnight/45 via-midnight/25 to-midnight/75"
        ></div>
      </div>

      <!-- Entire interface fades in as one composition -->
      <div
        class="connect-interface relative z-10 mx-auto flex min-h-[calc(100dvh-1.5rem)] w-full flex-col px-5 py-6 sm:min-h-[calc(100dvh-2.5rem)] sm:px-7 sm:py-8"
      >
        <!-- Brand block -->
        <header class="mt-8 text-center sm:mt-10">
          <!-- AOSET Visuals Vertical Logo -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill-rule="evenodd"
            stroke-linejoin="round"
            stroke-miterlimit="2"
            clip-rule="evenodd"
            viewBox="0 0 512 512"
            class="mx-auto w-32 text-white sm:w-36"
            role="img"
            aria-label="AOSET Visuals"
          >
            <path
              fill="currentColor"
              d="M136.61 239.05C81.82 184.4 81.82 95.66 136.61 41c54.8-54.66 143.74-54.66 198.54 0a139.79 139.79 0 0 1 26.51 36.78h-.01l1.16 2.34 16.2-32.4 47.95 23.86-34.2 68.45 34.23 68.5-47.97 23.85-65.34-130.74a86.34 86.34 0 0 0-16.44-22.83c-33.87-33.8-88.85-33.8-122.72 0a86.45 86.45 0 0 0 0 122.43c33.87 33.8 88.85 33.8 122.72 0a86.12 86.12 0 0 0 20.96-33.77l28.94 57.9.02.05a141.16 141.16 0 0 1-12.01 13.63c-54.8 54.66-143.74 54.66-198.54 0"
            />

            <path
              fill="currentColor"
              d="M142.5 503.76l14.39-33.4h7.48l-17.8 39.93h-8.16l-17.8-39.93h7.49zm32.27 6.53v-39.93h6.82v39.93zm3.41-47.67a4.35 4.35 0 0 1-3.24-1.38 4.44 4.44 0 0 1-1.33-3.2q0-1.91 1.34-3.28a4.35 4.35 0 0 1 3.24-1.38 4.35 4.35 0 0 1 3.25 1.38 4.57 4.57 0 0 1 1.33 3.28q0 1.83-1.33 3.2a4.35 4.35 0 0 1-3.25 1.38m32.95 49q-4.87 0-8.87-1.95-4-1.96-6.34-5.29a12.6 12.6 0 0 1-2.35-7.4h7.16a6.62 6.62 0 0 0 1.43 4.12q1.43 1.88 3.87 2.95a13.24 13.24 0 0 0 5.43 1.08q2.58 0 4.67-.86t3.33-2.37a5.17 5.17 0 0 0 1.23-3.34q0-1.9-1.28-3-1.3-1.08-3.43-1.73a50.43 50.43 0 0 0-4.69-1.18q-2.57-.58-5.32-1.25a23 23 0 0 1-5.03-1.82 10.09 10.09 0 0 1-3.7-3.12q-1.42-1.96-1.42-5.06a11.16 11.16 0 0 1 1.83-6.25 13.24 13.24 0 0 1 5-4.46 14.81 14.81 0 0 1 6.98-1.66q4.38 0 7.91 1.62 3.54 1.62 5.64 4.36a9.9 9.9 0 0 1 2.1 6.16h-7.16q0-1.58-1.14-2.87t-3.05-2.04a11.66 11.66 0 0 0-4.3-.74q-1.94 0-3.55.66a6.3 6.3 0 0 0-2.52 1.76 3.78 3.78 0 0 0-.91 2.48 3.03 3.03 0 0 0 .86 2.22 6.3 6.3 0 0 0 2.34 1.41 26.16 26.16 0 0 0 3.36.95q1.92.42 4 .83 2.5.5 5.03 1.3a20.8 20.8 0 0 1 4.66 2.07 9.58 9.58 0 0 1 3.37 3.45q1.25 2.17 1.25 5.45 0 3.75-2.2 6.85-2.2 3.11-5.9 4.89-3.72 1.78-8.3 1.78m59.4-7.86a17.33 17.33 0 0 1-5.06 5.24 15.35 15.35 0 0 1-8.74 2.62q-4.9 0-8.86-2.45a17.96 17.96 0 0 1-6.28-6.66q-2.33-4.2-2.33-9.36v-22.8h7.32v22.8q0 3.33 1.58 6.08a11.57 11.57 0 0 0 4.33 4.32 11.98 11.98 0 0 0 6.07 1.58 11.22 11.22 0 0 0 6.11-1.7 12.3 12.3 0 0 0 4.3-4.62 13.4 13.4 0 0 0 1.57-6.5v-21.95h7.32v39.93h-7.32zc.37-.57 0 0 0 0m56.83-.2a20.17 20.17 0 0 1-5.62 5.23q-4.53 2.83-10.1 2.83-5.9 0-10.73-2.83a21 21 0 0 1-7.66-7.7q-2.83-4.87-2.83-10.78 0-5.99 2.83-10.81a21.12 21.12 0 0 1 7.66-7.66q4.82-2.82 10.73-2.82 5.58 0 10.1 2.82 3.3 2.07 5.62 5.21v-6.7h6.83v39.93h-6.83zm0-13.23q0-4.16-2-7.54a14.81 14.81 0 0 0-5.37-5.32q-3.37-1.96-7.6-1.96t-7.62 1.96a14.81 14.81 0 0 0-5.36 5.32q-2 3.36-2 7.53t2 7.53a14.81 14.81 0 0 0 5.36 5.33q3.38 1.95 7.61 1.95t7.61-1.95a14.81 14.81 0 0 0 5.38-5.32q2-3.36 2-7.53m22.12-39.94h7v59.9h-7zm36.03 61.23q-4.87 0-8.87-1.95-4-1.96-6.34-5.29a12.6 12.6 0 0 1-2.35-7.4h7.16a6.62 6.62 0 0 0 1.43 4.12q1.43 1.88 3.87 2.95a13.24 13.24 0 0 0 5.43 1.08q2.58 0 4.68-.86t3.32-2.37a5.17 5.17 0 0 0 1.24-3.34q0-1.9-1.3-3-1.28-1.08-3.42-1.73-2.13-.66-4.69-1.18-2.58-.58-5.32-1.25a23 23 0 0 1-5.03-1.82 10.09 10.09 0 0 1-3.7-3.12q-1.42-1.96-1.42-5.06a11.16 11.16 0 0 1 1.83-6.25 13.24 13.24 0 0 1 5-4.46 14.81 14.81 0 0 1 6.98-1.66q4.38 0 7.91 1.62 3.54 1.62 5.64 4.36a9.9 9.9 0 0 1 2.09 6.16h-7.15q0-1.58-1.14-2.87-1.14-1.3-3.04-2.04a11.66 11.66 0 0 0-4.3-.74q-1.95 0-3.56.66a6.3 6.3 0 0 0-2.52 1.76 3.78 3.78 0 0 0-.92 2.48 3.03 3.03 0 0 0 .88 2.22 6.3 6.3 0 0 0 2.33 1.41 26.16 26.16 0 0 0 3.36.95q1.9.42 3.99.83 2.48.5 5.02 1.3a20.8 20.8 0 0 1 4.66 2.07 9.58 9.58 0 0 1 3.37 3.45q1.25 2.17 1.25 5.45 0 3.75-2.2 6.85t-5.9 4.89q-3.72 1.78-8.3 1.78M95.9 427.56a87.4 43.7 0 0 1-12.42 9.9q-12.57 7.36-28.14 7.36-15.33 0-28-7.35-12.63-7.36-19.99-20.01-7.34-12.64-7.34-28 0-15.57 7.35-28.1 7.35-12.55 20-19.9t28-7.35q15.56 0 28.13 7.36 12.52 7.35 19.88 19.9 7.35 12.53 7.35 28.1v51.9H95.9zm0-38.1v-.06q0-11.72-5.42-21.13-5.43-9.43-14.58-14.98-9.17-5.56-20.54-5.56-11.24 0-20.45 5.57t-14.65 15q-5.45 9.42-5.45 21.1t5.46 21.15q5.44 9.47 14.64 15.05t20.53 5.6 20.43-5.58q9.1-5.55 14.57-15.03 5.45-9.45 5.46-21.14M176.44 444.82a54.63 54.63 0 0 1-48-27.35 54.63 54.63 0 0 1-7.36-28 54.63 54.63 0 0 1 27.35-48 54.63 54.63 0 0 1 28-7.35 54.63 54.63 0 0 1 48.01 27.25 54.63 54.63 0 0 1 7.35 28.1q0 15.36-7.35 28a54.54 54.54 0 0 1-48 27.35m.07-13.61q11.33 0 20.44-5.58a41.79 41.79 0 0 0 20.02-36.23 41.52 41.52 0 0 0-20-36.1 38.78 38.78 0 0 0-20.53-5.56A38.78 38.78 0 0 0 156 353.3a41.52 41.52 0 0 0-20.1 36.1 41.65 41.65 0 0 0 20.1 36.2q9.2 5.6 20.5 5.6M287.18 444.82a49.16 49.16 0 0 1-22.5-5.08 41.79 41.79 0 0 1-16.1-13.72 33.19 33.19 0 0 1-5.95-19.26h15.57q0 6.6 4 12.1a27.31 27.31 0 0 0 10.75 8.64q6.78 3.16 15.1 3.16 7.46 0 13.53-2.57a23.76 23.76 0 0 0 9.61-7.1 15.7 15.7 0 0 0 3.56-9.97q0-5.5-3.5-8.56a25.95 25.95 0 0 0-9.3-4.87 135.2 135.2 0 0 0-12.7-3.27q-6.87-1.55-14.13-3.28a65.55 65.55 0 0 1-13.26-4.58 25.95 25.95 0 0 1-9.76-7.84q-3.73-4.95-3.73-12.88 0-8.85 4.78-16a34.14 34.14 0 0 1 13-11.4 39.06 39.06 0 0 1 18.22-4.23q11.07 0 20.02 4.2a36.87 36.87 0 0 1 14.26 11.37 25.95 25.95 0 0 1 5.3 16h-15.57q0-4.87-3.23-8.86a21.85 21.85 0 0 0-8.6-6.27 31.41 31.41 0 0 0-12.18-2.28q-5.83 0-10.67 2.08a19.12 19.12 0 0 0-7.63 5.54 12.3 12.3 0 0 0-2.77 7.84q0 4.06 2.5 6.58a17.75 17.75 0 0 0 6.7 4.06q4.2 1.53 9.57 2.65l11.16 2.39q6.49 1.4 12.96 3.37 6.46 1.97 11.83 5.22 5.38 3.24 8.52 8.67 3.14 5.45 3.14 13.8 0 9.53-5.7 17.4a38.78 38.78 0 0 1-15.29 12.42 49.98 49.98 0 0 1-21.5 4.52M356.81 394.99q1.03 7.99 5.14 15.02a42.34 42.34 0 0 0 14.89 15.13q9.42 5.74 20.82 5.74 6.6 0 13.62-2.19a54.63 54.63 0 0 0 12.97-5.92 34.14 34.14 0 0 0 9.42-8.33l9.4 9.62a43.7 43.7 0 0 1-12.33 10.5 79.2 79.2 0 0 1-16.65 7.45 57.36 57.36 0 0 1-17.3 2.81q-15.35 0-27.9-7.35a54.63 54.63 0 0 1-19.9-20 54.63 54.63 0 0 1-7.34-28q0-15.57 6.48-28.1a50.53 50.53 0 0 1 18.17-19.9q11.67-7.35 26.97-7.35 16.54 0 28.54 7.43a50.94 50.94 0 0 1 18.6 20.02q6.6 12.6 6.76 28.45 0 1.17-.1 2.48a9.56 9.56 0 0 1-.56 2.49zm75.09-12.77q-.82-7.58-3.93-14.27a34.14 34.14 0 0 0-12.6-14.48q-8.37-5.4-20.96-5.4-12.37 0-20.87 5.4a34.14 34.14 0 0 0-12.78 14.72 46.43 46.43 0 0 0-3.86 14.02zM474.75 314.11v27.71h33.73v12.21h-33.73v49.16q0 6.52 2.96 11.89a24.2 22.53 0 0 0 7.97 8.56 19.07 17.75 0 0 0 11.07 3.17H512v14.6h-16.35q-10.25 0-18.54-5.11a39.6 36.87 0 0 1-13.2-13.8 44 40.97 0 0 1-4.93-19.32v-89.07z"
            />
          </svg>

          <!-- Brand slogan -->
          <p
            class="mt-8 text-[0.7rem] font-medium uppercase tracking-[0.24em] text-white/70"
          >
            Elevating the Visible Layer
          </p>
        </header>

        <!-- Positioning bridge -->
        <div class="mt-auto text-center">
          <p
            class="mx-auto max-w-72 text-lg font-medium leading-snug text-white"
          >
            Design &amp; Presentation
            <span class="block text-white/75">
              for Premium Spaces
            </span>
          </p>
        </div>

        <!-- Thumb-zone actions -->
        <div class="pb-12 pt-8 sm:pb-14">
          <div class="space-y-3">
            <!-- Primary action -->
            <a
              id="save-vcard-link"
              href="/api/connect"
              class="flex w-full items-center justify-center rounded-xl bg-accent px-5 py-3.5 text-sm font-semibold text-white shadow-md transition-colors hover:bg-accent-hover active:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              aria-label="Save contact for AOSET Visuals"
            >
              Save Contact
            </a>

            <!-- Preferred contact method -->
            <a
              href="https://wa.me/13054821642?text=Hello%20AOSET%20Visuals%2C%20I'd%20like%20to%20get%20in%20touch!"
              target="_blank"
              rel="noopener noreferrer"
              class="flex w-full items-center justify-center rounded-xl bg-[#25d366] px-5 py-3.5 text-sm font-semibold text-white shadow-md transition-colors hover:bg-[#20bd5a] active:bg-[#20bd5a] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              aria-label="Contact AOSET Visuals on WhatsApp"
            >
              WhatsApp
            </a>

            <!-- Secondary actions -->
            <div class="grid grid-cols-3 gap-2.5">
              <a
                href="https://aosetvisuals.com"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-sm font-medium text-white backdrop-blur-sm transition-colors hover:border-white/25 hover:bg-white/10 active:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                aria-label="Visit the AOSET Visuals website"
              >
                Website
              </a>

              <a
                href="tel:+13054821642"
                class="flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-sm font-medium text-white backdrop-blur-sm transition-colors hover:border-white/25 hover:bg-white/10 active:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                aria-label="Call AOSET Visuals"
              >
                Call
              </a>

              <button
                id="message-open"
                type="button"
                class="flex items-center justify-center rounded-xl border border-white/15 bg-white/5 px-3 py-3 text-sm font-medium text-white backdrop-blur-sm transition-colors hover:border-white/25 hover:bg-white/10 active:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                aria-label="Send a message"
              >
                Message
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick message dialog -->
    <dialog
      id="message-dialog"
      class="m-auto w-[calc(100%-2rem)] max-w-sm overflow-visible rounded-2xl border border-white/10 bg-midnight/95 p-0 text-white shadow-2xl backdrop:bg-transparent"
    >
      <div class="relative p-6 sm:p-7">
        <!-- Close dialog -->
        <button
          id="message-close"
          type="button"
          class="absolute right-4 top-4 flex size-9 items-center justify-center rounded-full text-white/50 transition-colors hover:bg-white/5 hover:text-white active:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          aria-label="Close message form"
        >
          <svg
            viewBox="0 0 24 24"
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>

        <!-- Form header -->
        <div class="pr-10">
          <h2 class="text-xl font-medium text-white">
            Send a Message
          </h2>
        </div>

        <!-- Streamlined Lead Capture Form -->
        <form id="connect-form" class="mt-6 space-y-3">
          <!-- Full Name -->
          <div>
            <input
              type="text"
              name="name"
              placeholder="Name *"
              autocomplete="name"
              required
              class="w-full rounded-lg border border-white/15 bg-white/5 px-3.5 py-2.5 text-sm text-white outline-none transition-colors placeholder:text-white/35 focus:border-accent"
            />
          </div>

          <!-- Email Address -->
          <div>
            <input
              type="email"
              name="email"
              placeholder="Email *"
              autocomplete="email"
              inputmode="email"
              required
              class="w-full rounded-lg border border-white/15 bg-white/5 px-3.5 py-2.5 text-sm text-white outline-none transition-colors placeholder:text-white/35 focus:border-accent"
            />
          </div>

          <!-- Phone Number -->
          <div>
            <input
              type="tel"
              name="phone"
              placeholder="Phone (optional)"
              autocomplete="tel"
              inputmode="tel"
              class="w-full rounded-lg border border-white/15 bg-white/5 px-3.5 py-2.5 text-sm text-white outline-none transition-colors placeholder:text-white/35 focus:border-accent"
            />
          </div>

          <!-- Message Body -->
          <div>
            <textarea
              name="message"
              placeholder="Message *"
              rows="3"
              required
              class="w-full resize-none rounded-lg border border-white/15 bg-white/5 px-3.5 py-2.5 text-sm text-white outline-none transition-colors placeholder:text-white/35 focus:border-accent"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="w-full rounded-xl bg-accent px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-hover active:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white disabled:cursor-not-allowed disabled:opacity-60"
          >
            Send
          </button>

          <!-- Form Status Message Element -->
          <p
            id="form-status"
            class="min-h-5 text-center text-xs font-medium text-white/50"
            aria-live="polite"
          ></p>
        </form>
      </div>
    </dialog>
  </main>

  <!-- Client-Side Behavior Script -->
  <script>
    // 1. Non-Safari iOS vCard Download Fallback Handler
    const vcardLink = document.getElementById(
      'save-vcard-link',
    ) as HTMLAnchorElement | null;

    if (vcardLink) {
      vcardLink.addEventListener('click', async (event) => {
        const userAgent = window.navigator.userAgent;
        const isIOS = /iPhone|iPad|iPod/i.test(userAgent);

        const isSafari =
          /^((?!chrome|android|crios|fxios|opera|opios).)*safari/i.test(
            userAgent,
          );

        // Force data-uri fallback on iOS non-Safari browsers
        if (isIOS && !isSafari) {
          event.preventDefault();

          try {
            const response = await fetch('/api/connect');

            if (!response.ok) {
              throw new Error('vCard fetch failed');
            }

            const vcardText = await response.text();

            window.location.href =
              'data:text/vcard;charset=utf-8,' +
              encodeURIComponent(vcardText);
          } catch (error) {
            console.error(
              '[Client Error] vCard download failed:',
              error,
            );
          }
        }
      });
    }

    // 2. Quick Message Dialog Controls
    const messageDialog = document.getElementById(
      'message-dialog',
    ) as HTMLDialogElement | null;

    const messageOpen = document.getElementById(
      'message-open',
    ) as HTMLButtonElement | null;

    const messageClose = document.getElementById(
      'message-close',
    ) as HTMLButtonElement | null;

    let dialogCloseTimer: number | undefined;

    function openMessageDialog(): void {
      if (!messageDialog || messageDialog.open) {
        return;
      }

      if (dialogCloseTimer !== undefined) {
        window.clearTimeout(dialogCloseTimer);
        dialogCloseTimer = undefined;
      }

      messageDialog.showModal();

      /*
       * Wait two animation frames so the browser first paints
       * the initial hidden state before activating the reveal.
       */
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          messageDialog.classList.add('is-visible');
        });
      });
    }

    function closeMessageDialog(): void {
      if (!messageDialog || !messageDialog.open) {
        return;
      }

      messageDialog.classList.remove('is-visible');

      /*
       * Keep the native dialog in the top layer while the exit
       * animation finishes, then close it completely.
       */
      dialogCloseTimer = window.setTimeout(() => {
        messageDialog.close();
        dialogCloseTimer = undefined;
      }, 320);
    }

    messageOpen?.addEventListener('click', openMessageDialog);

    messageClose?.addEventListener('click', closeMessageDialog);

    // Close dialog when tapping outside the panel
    messageDialog?.addEventListener('click', (event) => {
      if (event.target === messageDialog) {
        closeMessageDialog();
      }
    });

    // Preserve Escape-key support while allowing the exit animation
    messageDialog?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeMessageDialog();
    });

    // Reset animation state after native dialog closes
    messageDialog?.addEventListener('close', () => {
      messageDialog.classList.remove('is-visible');
    });

    // 3. Contact Form Submission Handler
    const form = document.getElementById(
      'connect-form',
    ) as HTMLFormElement | null;

    const statusText = document.getElementById(
      'form-status',
    ) as HTMLParagraphElement | null;

    if (form && statusText) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        const submitButton = form.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement | null;

        // Reset status to neutral sending state
        statusText.textContent = 'Sending...';
        statusText.className =
          'min-h-5 text-center text-xs font-medium text-white/50';

        if (submitButton) {
          submitButton.disabled = true;
        }

        const formData = new FormData(form);

        /*
         * Keep one visible Name field while adapting the payload
         * to the field names expected by /api/connect.
         */
        const fullName =
          formData.get('name')?.toString().trim() || '';

        const nameParts = fullName
          .split(/\s+/)
          .filter(Boolean);

        const firstName = nameParts.shift() || '';

        /*
         * Use an em dash when only one name is provided.
         * This keeps lastName non-empty for backend validation.
         */
        const lastName =
          nameParts.join(' ') || '—';

        const payload = {
          firstName,
          lastName,

          email:
            formData
              .get('email')
              ?.toString()
              .trim()
              .toLowerCase() || '',

          phone:
            formData
              .get('phone')
              ?.toString()
              .trim() || '',

          subject:
            'Quick message from AOSET Connect',

          message:
            formData
              .get('message')
              ?.toString()
              .trim() || '',
        };

        try {
          const response = await fetch('/api/connect', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const data = await response.json();

          if (response.ok && data.success) {
            // Success state
            statusText.textContent =
              'Message sent successfully.';

            statusText.className =
              'min-h-5 text-center text-xs font-medium text-green-400';

            form.reset();
          } else {
            /*
             * Keep the technical backend error in the console,
             * while presenting a simple message to the visitor.
             */
            console.error(
              '[Server Error] Message submission failed:',
              data.error || `HTTP ${response.status}`,
            );

            statusText.textContent =
              'Unable to send message. Please try again.';

            statusText.className =
              'min-h-5 text-center text-xs font-medium text-red-400';
          }
        } catch (error) {
          console.error(
            '[Client Error] Message submission failed:',
            error,
          );

          // Failure state
          statusText.textContent =
            'Unable to send message. Please try again.';

          statusText.className =
            'min-h-5 text-center text-xs font-medium text-red-400';
        } finally {
          if (submitButton) {
            submitButton.disabled = false;
          }
        }
      });
    }
  </script>
</Layout>

