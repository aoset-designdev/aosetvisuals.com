---
// src/components/WhyChooseUs.astro
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props { 
  locale: Locale; 
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
  <!-- Section Heading -->
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-semibold leading-tight text-text sm:text-4xl">
      {t.whyChooseUs.heading}
    </h2>

    {t.whyChooseUs.subheading && (
      <p class="mt-4 text-base leading-relaxed text-text-muted">
        {t.whyChooseUs.subheading}
      </p>
    )}
  </div>

  <!-- Feature Cards Grid -->
  <ul class="mt-12 grid grid-cols-1 gap-8 text-center sm:grid-cols-2 lg:grid-cols-4">
    {t.whyChooseUs.features.map((feature, index) => (
      <li class="border-border bg-surface/30 hover:border-accent/30 flex h-full flex-col items-center rounded-2xl border p-8 shadow-xs transition-all duration-300 hover:shadow-md">
        
        <!-- Optional Index / Icon Accent Badge -->
        <span class="bg-accent/10 text-accent mb-4 flex h-10 w-10 items-center justify-center rounded-full text-sm font-semibold">
          {index + 1}
        </span>

        <!-- Title -->
        <h3
          class="text-text text-xl font-semibold leading-snug sm:text-2xl"
          set:html={feature.title}
        />

        <!-- Description -->
        <p class="text-text-muted mt-3 text-sm leading-relaxed">
          {feature.text}
        </p>
      </li>
    ))}
  </ul>
</section>