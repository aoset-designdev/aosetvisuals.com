---
// src/components/OurProcess.astro

// Uncomment these imports when your assets exist at src/assets/about/
// import process1 from '@/assets/about/process-1.jpg';
// import process2 from '@/assets/about/process-2.jpg';
// import process3 from '@/assets/about/process-3.jpg';
// import process4 from '@/assets/about/process-4.jpg';
// import { Image } from 'astro:assets';

import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Map images to match process steps
// const processImages = [process1, process2, process3, process4];

// Temporary placeholder colors (remove once real images are added)
const placeholderColors = [
  'bg-slate',
  'bg-aoset-blue',
  'bg-midnight',
  'bg-slate',
];
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
  <!-- Section Header -->
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-semibold leading-tight text-text sm:text-4xl">
      {t.about.process.heading}
    </h2>

    <p class="mt-4 text-base leading-relaxed text-text-muted">
      {t.about.process.intro}
    </p>
  </div>

  <!-- Ordered Process Steps -->
  <ol class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {t.about.process.steps.map((step, index) => (
      <li class="flex flex-col items-center text-center">

        <!-- Image Container -->
        <div class="relative aspect-245/420 w-full max-w-65 overflow-hidden rounded-xl border border-border shadow-md">

          <!--
            Uncomment when images are added:

            <Image
              src={processImages[index]}
              alt={step.title}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 hover:scale-105"
              widths={[260, 520]}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
              format="avif"
              quality={80}
              loading="lazy"
              decoding="async"
            />
          -->

          <!-- Placeholder -->
          <div class={`flex h-full w-full items-center justify-center p-4 ${placeholderColors[index]}`}>
            <span class="rounded bg-black/20 px-2.5 py-1 font-mono text-xs text-white/80">
              process-{index + 1}.jpg
            </span>
          </div>
        </div>

        <!-- Step Counter -->
        <span class="mt-6 block text-sm font-bold uppercase tracking-widest text-accent">
          <span class="sr-only">Step </span>
          {String(index + 1).padStart(2, '0')}
        </span>

        <!-- Step Content -->
        <h3 class="mt-2 text-xl font-semibold leading-snug text-text sm:text-2xl">
          {step.title}
        </h3>

        <p class="mt-3 max-w-xs text-sm leading-relaxed text-text-muted">
          {step.text}
        </p>

      </li>
    ))}
  </ol>
</section>