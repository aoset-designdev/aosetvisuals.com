---
// src/components/Header.astro
import {
  useTranslations,
  localizePath,
  switchLocalePath,
} from '../i18n/utils';

import {
  locales,
  localeNames,
  type Locale,
} from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const navItems = [
  { key: 'home'     as const, path: '' },
  { key: 'about'    as const, path: '/about' },
  { key: 'services' as const, path: '/services' },
  { key: 'work'     as const, path: '/work' },
  { key: 'contact'  as const, path: '/contact' },
];

const currentPath = Astro.url.pathname;

function isActive(path: string): boolean {
  const target =
    localizePath(locale, path).replace(/\/$/, '') || '/';

  const current =
    currentPath.replace(/\/$/, '') || '/';

  return current === target;
}
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-surface/90 backdrop-blur-sm"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3 sm:px-6 lg:px-8"
  >
    <!-- Brand -->
    <a
      href={localizePath(locale, '/')}
      class="brand-link group flex shrink-0 items-center rounded-xs text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      aria-label="AOSET Visuals — Home"
    >
      <!--
        Desktop brand lockup.

        The full SVG width is preserved at all times so revealing
        "visuals" never moves the navigation or changes the layout.

        Color behavior:
        - Symbol: AOSET Blue.
        - AOSET wordmark: follows the active text color.
        - VISUALS: AOSET Blue.

        Interaction:
        - AOSET is always visible.
        - VISUALS is revealed softly on hover or keyboard focus.
      -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 2573 512"
        class="hidden h-8 w-auto md:block lg:h-9"
        role="img"
        aria-label="AOSET Visuals"
