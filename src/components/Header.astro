---
// src/components/Header.astro

/**
 * AOSET Visuals — Global Header
 *
 * Responsibilities:
 * - Brand lockup
 * - Localized navigation
 * - About anchor navigation
 * - Language switching
 * - Theme switching
 * - Responsive mobile navigation
 *
 * Mobile navigation:
 * - Uses a controlled button + panel rather than <details>.
 * - Opens and closes with a smooth fade / slide transition.
 * - Occupies the remaining viewport height below the header.
 * - Uses larger editorial navigation links on mobile.
 * - Locks background scrolling while open.
 *
 * Theme-aware interface elements use semantic design tokens
 * and transition smoothly between light and dark modes.
 */

import {
  useTranslations,
  localizePath,
  switchLocalePath,
} from '../i18n/utils';

import {
  locales,
  localeNames,
  type Locale,
} from '../i18n/config';


/* ============================================================
   COMPONENT PROPS
   ============================================================ */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const t = useTranslations(locale);


/* ============================================================
   NAVIGATION
   ------------------------------------------------------------
   Standard items use localized routes.

   About points to the #about section on the localized homepage.
   Keeping the hash separate avoids passing it to localizePath().
   ============================================================ */

const navItems = [
  {
    key: 'home' as const,
    path: '',
  },

  {
    key: 'about' as const,
    path: '',
    hash: 'about',
  },

  {
    key: 'work' as const,
    path: '/work',
  },

  {
    key: 'contact' as const,
    path: '/contact',
  },
];


/* ============================================================
   CURRENT ROUTE
   ============================================================ */

const currentPath = Astro.url.pathname;


/**
 * Determine whether a regular route is currently active.
 *
 * Hash-based items such as About are intentionally excluded.
 */
function isActive(path: string): boolean {
  const target =
    localizePath(locale, path).replace(/\/$/, '') || '/';

  const current =
    currentPath.replace(/\/$/, '') || '/';

  return current === target;
}


/**
 * Build the final localized navigation URL.
 *
 * Examples:
 *
 * Home:
 * /en/
 *
 * About:
 * /en/#about
 *
 * Projects:
 * /en/work
 *
 * Contact:
 * /en/contact
 */
function navHref(
  item: (typeof navItems)[number],
): string {
  const base =
    localizePath(locale, item.path);

  return item.hash
    ? `${base}#${item.hash}`
    : base;
}
---

<header
  id="site-header"
  class="
    sticky
    top-0
    z-50
    w-full

    border-b
    border-border

    bg-surface/90
    backdrop-blur-sm

    transition-colors
    duration-200

    motion-reduce:transition-none
  "
>
  <div
    class="
      mx-auto
      flex
      max-w-7xl
      items-center
      justify-between
      gap-6

      px-4
      py-3

      sm:px-6
      lg:px-8
    "
  >
    <!-- ===================================================== -->
    <!-- BRAND                                                 -->
    <!-- ===================================================== -->

