      </svg>

      <!--
        Mobile brand lockup.

        Mobile intentionally uses AOSET without the hover reveal.
        This keeps the header compact and avoids hover-dependent
        behavior on touch devices.
      -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1642 512"
        class="h-8 w-auto text-text md:hidden"
        role="img"
        aria-label="AOSET Visuals"
      >
        <!-- Brand symbol -->
        <path
          fill="#348eba"
          d="M75.13 437.045c-100.175-99.937-100.175-262.156 0-362.093 100.184-99.937 262.791-99.937 362.97 0a255.574 255.574 0 0 1 48.484 67.239l-.033.017 2.13 4.268 29.604-59.234 87.684 43.62-62.545 125.147 62.587 125.227-87.689 43.615-119.46-239.029a157.855 157.855 0 0 0-30.055-41.743c-61.93-61.781-162.452-61.781-224.379 0-61.93 61.776-61.93 162.06 0 223.836 61.927 61.784 162.448 61.784 224.38 0 17.998-17.957 30.772-39.172 38.306-61.747l52.91 105.875.042.08a258.08 258.08 0 0 1-21.966 24.922c-100.183 99.933-262.79 99.933-362.97 0"
        />

