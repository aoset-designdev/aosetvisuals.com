    </a>

    <!-- Desktop nav -->
    <nav
      aria-label="Main navigation"
      class="hidden md:block"
    >
      <ul
        class="flex items-center gap-5 text-sm font-medium lg:gap-8"
      >
        {navItems.map((item) => (
          <li>
            <a
              href={localizePath(locale, item.path)}
              aria-current={
                isActive(item.path)
                  ? 'page'
                  : undefined
              }
              class={`rounded-xs transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent ${
                isActive(item.path)
                  ? 'text-accent'
                  : 'text-text-muted'
              }`}
            >
              {t.nav[item.key]}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Desktop controls -->
    <div
      class="hidden items-center gap-3 md:flex"
    >
      <!-- Language switcher -->
      <details
        class="js-dropdown relative"
      >
        <summary
          class="flex cursor-pointer list-none items-center gap-1 rounded-md px-2 py-1 text-sm font-medium text-text-muted hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent [&::-webkit-details-marker]:hidden"
          aria-label="Select language"
        >
          {locale.toUpperCase()}

          <svg
            viewBox="0 0 20 20"
            class="h-3 w-3"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414Z"
            />
          </svg>
        </summary>

        <ul
          class="absolute right-0 mt-2 min-w-32 rounded-md border border-border bg-surface py-1 shadow-lg"
        >
          {locales.map((l) => (
            <li>
              <a
                href={switchLocalePath(
                  Astro.url,
                  l
                )}
                class={`block px-3 py-1.5 text-sm transition-colors hover:text-accent ${
                  l === locale
                    ? 'font-medium text-accent'
                    : 'text-text-muted'
                }`}
              >
                {localeNames[l]}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="flex h-9 w-9 items-center justify-center rounded-md text-text-muted transition-colors hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <svg
          id="icon-sun"
          viewBox="0 0 24 24"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle
            cx="12"
            cy="12"
            r="4"
          />

          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
          />
        </svg>

        <svg
          id="icon-moon"
          viewBox="0 0 24 24"
          class="hidden h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
          />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <details
      class="js-dropdown md:hidden"
    >
      <summary
        class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md text-text hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent [&::-webkit-details-marker]:hidden"
        aria-label="Toggle menu"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </summary>

      <div
        class="absolute inset-x-0 top-full border-t border-border bg-surface px-4 py-4 shadow-lg"
      >
        <ul
          class="flex flex-col gap-3 text-sm font-medium"
        >
          {navItems.map((item) => (
            <li>
              <a
                href={localizePath(
                  locale,
                  item.path
                )}
                aria-current={
                  isActive(item.path)
                    ? 'page'
                    : undefined
                }
                class={`block py-1 transition-colors hover:text-accent ${
                  isActive(item.path)
                    ? 'text-accent'
                    : 'text-text-muted'
                }`}
              >
                {t.nav[item.key]}
              </a>
            </li>
          ))}
        </ul>

        <div
          class="mt-4 flex items-center gap-3 border-t border-border pt-4"
        >
          {locales.map((l) => (
            <a
              href={switchLocalePath(
                Astro.url,
                l
              )}
              class={`text-sm transition-colors hover:text-accent ${
                l === locale
                  ? 'font-semibold text-accent'
                  : 'text-text-muted'
              }`}
            >
              {l.toUpperCase()}
            </a>
          ))}

          <button
            id="theme-toggle-mobile"
            type="button"
            class="ml-auto flex h-8 w-8 items-center justify-center rounded-md text-text-muted hover:text-accent"
            aria-label="Toggle dark mode"
          >
            <svg
              id="icon-sun-mobile"
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle
                cx="12"
                cy="12"
                r="4"
              />

              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              />
            </svg>

            <svg
              id="icon-moon-mobile"
              viewBox="0 0 24 24"
              class="hidden h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
              />
            </svg>
          </button>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  function initHeader() {
    // 1. Theme sync & toggle logic
    function syncIcons() {
      const isDark =
        document.documentElement.getAttribute(
          'data-theme'
        ) === 'dark';

      document
        .getElementById('icon-sun')
        ?.classList.toggle(
          'hidden',
          isDark
        );

      document
        .getElementById('icon-moon')
        ?.classList.toggle(
          'hidden',
          !isDark
        );

      document
        .getElementById('icon-sun-mobile')
        ?.classList.toggle(
          'hidden',
          isDark
        );

      document
        .getElementById('icon-moon-mobile')
        ?.classList.toggle(
          'hidden',
          !isDark
        );
    }

    function toggleTheme() {
      const html =
        document.documentElement;

      const next =
        html.getAttribute('data-theme') ===
        'dark'
          ? 'light'
          : 'dark';

      html.setAttribute(
        'data-theme',
        next
      );

      try {
        localStorage.setItem(
          'aoset-theme',
          next
        );
      } catch (_) {}

      syncIcons();
    }

    document
      .getElementById('theme-toggle')
      ?.addEventListener(
        'click',
        toggleTheme
      );

    document
      .getElementById(
        'theme-toggle-mobile'
      )
      ?.addEventListener(
        'click',
        toggleTheme
      );

    syncIcons();

    // 2. Auto-close <details> dropdowns when clicking outside or clicking a nav link
    const dropdowns =
      document.querySelectorAll<HTMLDetailsElement>(
        'details.js-dropdown'
      );

    document.addEventListener(
      'click',
      (e) => {
        const target =
          e.target as Node;

        dropdowns.forEach(
          (details) => {
            if (
              !details.contains(target)
            ) {
              details.removeAttribute(
                'open'
              );
            }
          }
        );
      }
    );

    dropdowns.forEach(
      (details) => {
        details
          .querySelectorAll('a')
          .forEach((link) => {
            link.addEventListener(
              'click',
              () => {
                details.removeAttribute(
                  'open'
                );
              }
            );
          });
      }
    );
  }

  // Support initial page load + Astro client router view transitions
  initHeader();

  document.addEventListener(
    'astro:page-load',
    initHeader
  );
</script>

<style>
  /*
   * Brand reveal microinteraction.
   *
   * VISUALS begins slightly displaced, transparent,
   * and subtly compressed.
   *
   * The combination of opacity, translation, and scale
   * creates a refined reveal without affecting layout.
   */
  .brand-visuals {
    opacity: 0;

    transform:
      translateX(-14px)
      scale(0.975);

    transform-box: fill-box;
    transform-origin: left center;

    transition:
      opacity 520ms ease-out,
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1);

    will-change:
      opacity,
      transform;
  }

  /*
   * Reveal VISUALS when the brand is hovered
   * or receives keyboard focus.
   */
  .brand-link:hover .brand-visuals,
  .brand-link:focus-visible .brand-visuals {
    opacity: 1;

    transform:
      translateX(0)
      scale(1);
  }

  /*
   * Respect reduced-motion preferences.
   * The word remains available without movement.
   */
  @media (prefers-reduced-motion: reduce) {
    .brand-visuals {
      transition: none;
      transform: none;
    }

    .brand-link:hover .brand-visuals,
    .brand-link:focus-visible .brand-visuals {
      opacity: 1;
    }
  }
</style>