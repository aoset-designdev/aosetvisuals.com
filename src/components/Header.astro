          text-text-muted

          transition-colors
          duration-200

          hover:text-accent

          focus-visible:outline-none
          focus-visible:ring-2
          focus-visible:ring-accent

          motion-reduce:transition-none
        "
      >
        <svg
          id="icon-sun"
          viewBox="0 0 24 24"
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle
            cx="12"
            cy="12"
            r="4"
          ></circle>

          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
          ></path>
        </svg>

        <svg
          id="icon-moon"
          viewBox="0 0 24 24"
          class="hidden h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
          ></path>
        </svg>
      </button>
    </div>


    <!-- ===================================================== -->
    <!-- MOBILE MENU TOGGLE                                    -->
    <!-- ===================================================== -->

    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu-panel"
      class="
        mobile-menu-toggle

        relative

        flex
        size-10
        items-center
        justify-center

        rounded-md

        text-text

        transition-colors
        duration-200

        hover:text-accent

        focus-visible:outline-none
        focus-visible:ring-2
        focus-visible:ring-accent

        md:hidden

        motion-reduce:transition-none
      "
    >
      <!-- Hamburger / close icon -->
      <span
        class="mobile-menu-icon"
        aria-hidden="true"
      >
        <span class="mobile-menu-line"></span>
        <span class="mobile-menu-line"></span>
      </span>
    </button>
  </div>


  <!-- ======================================================= -->
  <!-- MOBILE NAVIGATION PANEL                                 -->
  <!--                                                         -->
  <!-- Full remaining viewport height below the sticky header. -->
  <!-- The panel remains mounted so both open and close states -->
  <!-- can animate smoothly.                                  -->
  <!-- ======================================================= -->

  <div
    id="mobile-menu-panel"
    class="
      mobile-menu-panel

      absolute
      inset-x-0
      top-full

      h-[calc(100svh-4rem)]

      border-t
      border-border

      bg-surface

      md:hidden
    "
    aria-hidden="true"
  >
    <div
      class="
        mx-auto
        flex
        h-full
        max-w-7xl
        flex-col

        px-6
        py-8
      "
    >
      <!-- ================================================= -->
      <!-- MOBILE PRIMARY NAVIGATION                         -->
      <!-- ================================================= -->

      <nav
        aria-label="Mobile navigation"
      >
        <ul
          class="
            mobile-nav-list

            flex
            flex-col
            gap-3
          "
        >
          {
            navItems.map((item) => {
              const active =
                !item.hash &&
                isActive(item.path);

              return (
                <li class="mobile-nav-item">
                  <a
                    href={navHref(item)}
                    aria-current={
                      active
                        ? 'page'
                        : undefined
                    }
                    class={`mobile-nav-link block py-2 font-editorial-body text-[1.55rem] font-light leading-tight tracking-[-0.02em] transition-colors duration-200 hover:text-accent focus-visible:outline-none focus-visible:text-accent motion-reduce:transition-none ${
                      active
                        ? 'text-accent'
                        : 'text-text'
                    }`}
                  >
                    {t.nav[item.key]}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>


      <!-- ================================================= -->
      <!-- MOBILE SECONDARY CONTROLS                         -->
      <!-- ================================================= -->

      <div
        class="
          mobile-menu-secondary

          mt-auto

          border-t
          border-border

          pt-6
          pb-2
        "
      >
        <div
          class="
            flex
            items-center
            justify-between
            gap-6
          "
        >
          <!-- Language choices -->
          <div
            class="
              flex
              items-center
              gap-4
            "
            aria-label="Language selector"
          >
            {
              locales.map((l) => (
                <a
                  href={switchLocalePath(
                    Astro.url,
                    l,
                  )}
                  class={`font-editorial-body text-sm uppercase tracking-[0.12em] transition-colors duration-200 hover:text-accent focus-visible:outline-none focus-visible:text-accent motion-reduce:transition-none ${
                    l === locale
                      ? 'font-medium text-accent'
                      : 'text-text-muted'
                  }`}
                >
                  {l.toUpperCase()}
                </a>
              ))
            }
          </div>


          <!-- Mobile theme toggle -->
          <button
            id="theme-toggle-mobile"
            type="button"
            aria-label="Toggle dark mode"
            class="
              flex
              size-10
              items-center
              justify-center

              rounded-full

              text-text-muted

              transition-colors
              duration-200

              hover:text-accent

              focus-visible:outline-none
              focus-visible:ring-2
              focus-visible:ring-accent

              motion-reduce:transition-none
            "
          >
            <svg
              id="icon-sun-mobile"
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle
                cx="12"
                cy="12"
                r="4"
              ></circle>

              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>

            <svg
              id="icon-moon-mobile"
              viewBox="0 0 24 24"
              class="hidden h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>


<script>
  /**
   * Initialize all interactive Header behavior.
   *
   * Element handlers use property assignment where appropriate
   * so Astro page-load reinitialization does not stack duplicate
   * handlers.
   */
  function initHeader() {
    /* ========================================================
       ELEMENT REFERENCES
       ======================================================== */

    const html =
      document.documentElement;

    const mobileMenuButton =
      document.getElementById(
        'mobile-menu-toggle',
      ) as HTMLButtonElement | null;

    const mobileMenuPanel =
      document.getElementById(
        'mobile-menu-panel',
      ) as HTMLDivElement | null;


    /* ========================================================
       THEME ICON SYNCHRONIZATION
       ======================================================== */

    function syncIcons() {
      const isDark =
        html.getAttribute(
          'data-theme',
        ) === 'dark';

      document
        .getElementById('icon-sun')
        ?.classList.toggle(
          'hidden',
          isDark,
        );

      document
        .getElementById('icon-moon')
        ?.classList.toggle(
          'hidden',
          !isDark,
        );

      document
        .getElementById('icon-sun-mobile')
        ?.classList.toggle(
          'hidden',
          isDark,
        );

      document
        .getElementById('icon-moon-mobile')
        ?.classList.toggle(
          'hidden',
          !isDark,
        );
    }


    /* ========================================================
       THEME TOGGLE
       ======================================================== */

    function toggleTheme() {
      const next =
        html.getAttribute(
          'data-theme',
        ) === 'dark'
          ? 'light'
          : 'dark';

      html.setAttribute(
        'data-theme',
        next,
      );

      try {
        localStorage.setItem(
          'aoset-theme',
          next,
        );
      } catch (_) {
        // Ignore environments where localStorage is unavailable.
      }

      syncIcons();
    }


    const desktopToggle =
      document.getElementById(
        'theme-toggle',
      );

    const mobileToggle =
      document.getElementById(
        'theme-toggle-mobile',
      );


    if (desktopToggle) {
      desktopToggle.onclick =
        toggleTheme;
    }

    if (mobileToggle) {
      mobileToggle.onclick =
        toggleTheme;
    }

    syncIcons();


    /* ========================================================
       MOBILE MENU
       ======================================================== */

    function isMobileMenuOpen(): boolean {
      return (
        mobileMenuButton
          ?.getAttribute(
            'aria-expanded',
          ) === 'true'
      );
    }


    function setMobileMenu(
      open: boolean,
    ) {
      if (
        !mobileMenuButton ||
        !mobileMenuPanel
      ) {
        return;
      }

      mobileMenuButton.setAttribute(
        'aria-expanded',
        String(open),
      );

      mobileMenuButton.setAttribute(
        'aria-label',
        open
          ? 'Close navigation menu'
          : 'Open navigation menu',
      );

      mobileMenuPanel.setAttribute(
        'aria-hidden',
        String(!open),
      );

      mobileMenuPanel.classList.toggle(
        'is-open',
        open,
      );

      mobileMenuButton.classList.toggle(
        'is-open',
        open,
      );

      document.body.classList.toggle(
        'mobile-menu-lock',
        open,
      );
    }


    if (mobileMenuButton) {
      mobileMenuButton.onclick = () => {
        setMobileMenu(
          !isMobileMenuOpen(),
        );
      };
    }


    /*
     * Close the mobile panel after selecting any navigation
     * or language link inside it.
     */
    if (mobileMenuPanel) {
      mobileMenuPanel
        .querySelectorAll<HTMLAnchorElement>(
          'a',
        )
        .forEach((link) => {
          link.onclick = () => {
            setMobileMenu(false);
          };
        });
    }


    /*
     * Always begin in the closed state after navigation.
     */
    setMobileMenu(false);


    /* ========================================================
       DESKTOP LANGUAGE DROPDOWN
       ======================================================== */

    const dropdowns =
      document.querySelectorAll<HTMLDetailsElement>(
        'details.js-dropdown',
      );

    dropdowns.forEach(
      (details) => {
        details
          .querySelectorAll<HTMLAnchorElement>(
            'a',
          )
          .forEach((link) => {
            link.onclick = () => {
              details.removeAttribute(
                'open',
              );
            };
          });
      },
    );
  }


  /* ==========================================================
     GLOBAL DOCUMENT EVENTS
     ----------------------------------------------------------
     These listeners are bound once and continue working across
     Astro navigation because they query the current DOM.
     ========================================================== */

  const html =
    document.documentElement;


  /* ----------------------------------------------------------
     Escape closes the mobile menu.
     ---------------------------------------------------------- */

  if (
    !html.dataset
      .aosetHeaderEscapeBound
  ) {
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape') {
          return;
        }

        const button =
          document.getElementById(
            'mobile-menu-toggle',
          ) as HTMLButtonElement | null;

        const panel =
          document.getElementById(
            'mobile-menu-panel',
          );

        if (
          !button ||
          !panel ||
          button.getAttribute(
            'aria-expanded',
          ) !== 'true'
        ) {
          return;
        }

        button.setAttribute(
          'aria-expanded',
          'false',
        );

        button.setAttribute(
          'aria-label',
          'Open navigation menu',
        );

        panel.setAttribute(
          'aria-hidden',
          'true',
        );

        panel.classList.remove(
          'is-open',
        );

        button.classList.remove(
          'is-open',
        );

        document.body.classList.remove(
          'mobile-menu-lock',
        );

        button.focus();
      },
    );

    html.dataset
      .aosetHeaderEscapeBound =
      'true';
  }


  /* ----------------------------------------------------------
     Desktop language dropdown outside click.
     ---------------------------------------------------------- */

  if (
    !html.dataset
      .aosetHeaderOutsideClickBound
  ) {
    document.addEventListener(
      'click',
      (event) => {
        const target =
          event.target;

        if (!(target instanceof Node)) {
          return;
        }

        document
          .querySelectorAll<HTMLDetailsElement>(
            'details.js-dropdown',
          )
          .forEach((details) => {
            if (
              !details.contains(target)
            ) {
              details.removeAttribute(
                'open',
              );
            }
          });
      },
    );

    html.dataset
      .aosetHeaderOutsideClickBound =
      'true';
  }


  /* ----------------------------------------------------------
     If viewport crosses into desktop, force the mobile panel
     closed and restore normal document scrolling.
     ---------------------------------------------------------- */

  if (
    !html.dataset
      .aosetHeaderResizeBound
  ) {
    window.addEventListener(
      'resize',
      () => {
        if (
          window.innerWidth < 768
        ) {
          return;
        }

        const button =
          document.getElementById(
            'mobile-menu-toggle',
          );

        const panel =
          document.getElementById(
            'mobile-menu-panel',
          );

        button?.setAttribute(
          'aria-expanded',
          'false',
        );

        button?.classList.remove(
          'is-open',
        );

        panel?.setAttribute(
          'aria-hidden',
          'true',
        );

        panel?.classList.remove(
          'is-open',
        );

        document.body.classList.remove(
          'mobile-menu-lock',
        );
      },
      {
        passive: true,
      },
    );

    html.dataset
      .aosetHeaderResizeBound =
      'true';
  }


  /* ==========================================================
     INITIALIZATION
     ========================================================== */

  initHeader();

  document.addEventListener(
    'astro:page-load',
    initHeader,
  );
</script>


<style>
  /* =========================================================
     BRAND REVEAL MICROINTERACTION
     ========================================================= */

  .brand-visuals {
    opacity: 0;

    transform:
      translateX(-14px)
      scale(0.975);

    transform-box: fill-box;
    transform-origin: left center;

    transition:
      opacity 520ms ease-out,
      transform 620ms
        cubic-bezier(
          0.16,
          1,
          0.3,
          1
        );

    will-change:
      opacity,
      transform;
  }


  .brand-link:hover
    .brand-visuals,
  .brand-link:focus-visible
    .brand-visuals {
    opacity: 1;

    transform:
      translateX(0)
      scale(1);
  }


  /* =========================================================
     MOBILE MENU ICON
     ---------------------------------------------------------
     Two lines transform into a restrained X.
     ========================================================= */

  .mobile-menu-icon {
    position: relative;

    display: block;

    width: 1.35rem;
    height: 1rem;
  }


  .mobile-menu-line {
    position: absolute;
    left: 0;

    display: block;

    width: 100%;
    height: 1px;

    background:
      currentColor;

    transition:
      top 320ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        ),
      transform 360ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        );
  }


  .mobile-menu-line:first-child {
    top: 0.28rem;
  }


  .mobile-menu-line:last-child {
    top: 0.72rem;
  }


  .mobile-menu-toggle.is-open
    .mobile-menu-line:first-child {
    top: 0.5rem;

    transform:
      rotate(45deg);
  }


  .mobile-menu-toggle.is-open
    .mobile-menu-line:last-child {
    top: 0.5rem;

    transform:
      rotate(-45deg);
  }


  /* =========================================================
     MOBILE MENU PANEL
     ---------------------------------------------------------
     The panel stays mounted so both directions can animate.

     Closed:
     - slightly raised
     - transparent
     - invisible / non-interactive

     Open:
     - settles into place
     - becomes fully visible
     ========================================================= */

  .mobile-menu-panel {
    visibility: hidden;

    opacity: 0;

    pointer-events: none;

    transform:
      translateY(-12px);

    transition:
      opacity 280ms ease,
      transform 420ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        ),
      visibility 0s linear 420ms,
      background-color 200ms ease,
      border-color 200ms ease;

    will-change:
      opacity,
      transform;
  }


  .mobile-menu-panel.is-open {
    visibility: visible;

    opacity: 1;

    pointer-events: auto;

    transform:
      translateY(0);

    transition:
      opacity 280ms ease,
      transform 420ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        ),
      visibility 0s linear 0s,
      background-color 200ms ease,
      border-color 200ms ease;
  }


  /* =========================================================
     MOBILE NAVIGATION STAGGER
     ---------------------------------------------------------
     Very restrained sequence. Links should feel composed,
     not theatrical.
     ========================================================= */

  .mobile-nav-item {
    opacity: 0;

    transform:
      translateY(-6px);

    transition:
      opacity 260ms ease,
      transform 360ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        );
  }


  .mobile-menu-panel.is-open
    .mobile-nav-item {
    opacity: 1;

    transform:
      translateY(0);
  }


  .mobile-menu-panel.is-open
    .mobile-nav-item:nth-child(1) {
    transition-delay: 60ms;
  }


  .mobile-menu-panel.is-open
    .mobile-nav-item:nth-child(2) {
    transition-delay: 90ms;
  }


  .mobile-menu-panel.is-open
    .mobile-nav-item:nth-child(3) {
    transition-delay: 120ms;
  }


  .mobile-menu-panel.is-open
    .mobile-nav-item:nth-child(4) {
    transition-delay: 150ms;
  }


  /* Secondary controls arrive slightly after primary nav. */
  .mobile-menu-secondary {
    opacity: 0;

    transform:
      translateY(6px);

    transition:
      opacity 280ms ease,
      transform 360ms
        cubic-bezier(
          0.22,
          1,
          0.36,
          1
        ),
      border-color 200ms ease;
  }


  .mobile-menu-panel.is-open
    .mobile-menu-secondary {
    opacity: 1;

    transform:
      translateY(0);

    transition-delay: 170ms;
  }


  /* =========================================================
     MOBILE SCROLL LOCK
     ---------------------------------------------------------
     Prevent the page behind the full-height navigation from
     scrolling while the menu is active.
     ========================================================= */

  :global(body.mobile-menu-lock) {
    overflow: hidden;
  }


  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .brand-visuals {
      transition: none;
      transform: none;
    }


    .brand-link:hover
      .brand-visuals,
    .brand-link:focus-visible
      .brand-visuals {
      opacity: 1;
    }


    .mobile-menu-line,
    .mobile-menu-panel,
    .mobile-nav-item,
    .mobile-menu-secondary {
      transition: none;
    }


    .mobile-menu-panel {
      transform: none;
    }


    .mobile-nav-item,
    .mobile-menu-secondary {
      transform: none;
    }
  }
</style>