<style>

  /* =========================================================

     DESKTOP BENTO HEIGHT

     ---------------------------------------------------------

     The bento adapts to available viewport height while

     preserving the established landscape composition.

     IMPORTANT:

     These values preserve the original bento geometry.

     ========================================================= */

  @media (min-width: 80rem) {

    .hero-bento {

      height: min(

        calc(100svh - 8rem),

        calc((100vw - 4rem) * 0.5625)

      );

      min-height: 700px;

      max-height: 900px;

    }

  }

  /* =========================================================

     CARD BASE

     ---------------------------------------------------------

     Cards intentionally have no visible border. Separation is

     created by spacing, radius, photography and surface value.

     ========================================================= */

  .hero-card {

    position: relative;

    overflow: hidden;

    isolation: isolate;

    backface-visibility: hidden;

    transform: translateZ(0);

  }

  /* =========================================================

     PROJECT IMAGES

     ========================================================= */

  .hero-card-image {

    width: 100%;

    height: 100%;

    object-fit: cover;

    object-position: center;

    transition:

      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),

      filter 500ms ease;

    will-change: transform;

  }

  /* =========================================================

     PHOTOGRAPHIC OVERLAY

     ---------------------------------------------------------

     This overlay belongs to image treatment rather than to

     light/dark interface theming.

     It therefore uses the stable AOSET dark brand primitive.

     ========================================================= */

  .hero-card-overlay {

    position: absolute;

    inset: 0;

    pointer-events: none;

    background:

      linear-gradient(

        to top,

        color-mix(

          in srgb,

          var(--brand-dark) 92%,

          transparent

        ) 0%,

        color-mix(

          in srgb,

          var(--brand-dark) 42%,

          transparent

        ) 38%,

        color-mix(

          in srgb,

          var(--brand-dark) 8%,

          transparent

        ) 72%,

        transparent 100%

      );

  }

  /* =========================================================

     CARD HOVER

     ---------------------------------------------------------

     Hover remains intentionally restrained.

     No borders are introduced during interaction.

     ========================================================= */

  @media (hover: hover) and (pointer: fine) {

    .hero-card {

      transition:

        transform 350ms cubic-bezier(0.22, 1, 0.36, 1),

        box-shadow 350ms ease;

    }

    /* Photographic project cards */

    .hero-photo-card:hover {

      transform: translateY(-3px);

      box-shadow:

        0 14px 36px

        rgb(0 0 0 / 0.14);

    }

    /* Slight image movement provides the primary hover cue. */

    .hero-photo-card:hover

      .hero-card-image {

      transform: scale(1.025);

    }

    /* Theme-aware technical card */

    .hero-tech-card:hover {

      transform: translateY(-3px);

      box-shadow:

        0 14px 36px

        rgb(0 0 0 / 0.08);

    }

  }

  /* =========================================================

     PHOTO CARD ACTION ARROWS

     ---------------------------------------------------------

     Arrow styling remains intentionally independent from the

     active site theme because the arrows always sit over

     darkened photography.

     ========================================================= */

  .hero-arrow {

    display: inline-grid;

    place-items: center;

    width: 2.5rem;

    height: 2.5rem;

    flex-shrink: 0;

    border:

      1px solid

      color-mix(

        in srgb,

        var(--brand-light) 28%,

        transparent

      );

    border-radius: 9999px;

    background:

      color-mix(

        in srgb,

        var(--brand-dark) 8%,

        transparent

      );

    color:

      var(--brand-light);

    transition:

      transform 300ms ease,

      border-color 300ms ease,

      background-color 300ms ease;

  }

  @media (hover: hover) and (pointer: fine) {

    .hero-photo-card:hover

      .hero-arrow {

      transform: translateX(2px);

      border-color:

        color-mix(

          in srgb,

          var(--brand-light) 50%,

          transparent

        );

      background-color:

        color-mix(

          in srgb,

          var(--brand-light) 7%,

          transparent

        );

    }

  }

  /* =========================================================

     HERO ENTRANCE

     ---------------------------------------------------------

     Soft staggered entrance without client-side JavaScript.

     ========================================================= */

  .hero-reveal {

    opacity: 0;

