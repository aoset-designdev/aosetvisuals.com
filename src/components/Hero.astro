---
// src/components/Hero.astro
import { useTranslations, localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props { 
  locale: Locale; 
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="relative isolate flex min-h-150 items-center overflow-hidden bg-ramp-900 sm:min-h-180 lg:min-h-215">

  <!-- Fallback Gradient Background -->
  <div class="absolute inset-0 -z-20 bg-linear-to-br from-ramp-900 to-ramp-700" aria-hidden="true"></div>

  <!-- Readability Overlay (Stronger on the left) -->
  <div class="absolute inset-0 -z-10 bg-linear-to-r from-black/80 via-black/50 to-black/30" aria-hidden="true"></div>

  <!-- Hero Content -->
  <div class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="max-w-2xl">

      <!-- Main Heading -->
      <h1
        class="text-4xl font-semibold leading-tight tracking-tight text-white sm:text-5xl lg:text-7xl lg:leading-[1.1]"
        set:html={t.hero.title}
      />

      <!-- Subtitle -->
      {t.hero.subtitle && (
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/90 sm:text-xl">
          {t.hero.subtitle}
        </p>
      )}

      <!-- CTA Button -->
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={localizePath(locale, '/contact')}
          class="inline-flex items-center justify-center rounded-md bg-accent px-8 py-3.5 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {t.hero.cta}
        </a>
      </div>

    </div>
  </div>

</section>