// src/components/Hero.astro

/**

 * AOSET Visuals - Portfolio Hero

 *

 * Responsive multilingual portfolio hero using an asymmetric

 * bento layout.

 *

 * Layout:

 * - Intro:      4 columns x 3 rows

 * - J&CO:       5 columns x 3 rows

 * - Campaign:   3 columns x 3 rows

 * - Seabiza:    4 columns x 2 rows

 * - Technical:  4 columns x 2 rows

 * - J&D:        4 columns x 2 rows

 *

 * Theme behavior:

 * - General interface surfaces and typography follow the

 *   semantic light/dark theme tokens.

 * - Photographic cards remain intentionally dark for stable

 *   image contrast in both themes.

 * - Theme-aware elements transition smoothly between modes.

 *

 * Visual treatment:

 * - Flat hero background.

 * - No ambient glow.

 * - No card borders.

 * - Photography, spacing, radius and surface contrast define

 *   the bento structure.

 *

 * IMPORTANT:

 * The established bento geometry is intentionally preserved.

 */

import { Image } from 'astro:assets';

import {

  useTranslations,

  localizePath,

} from '../i18n/utils';

import type { Locale } from '../i18n/config';

/* ============================================================

   PROJECT REGISTRY

   ------------------------------------------------------------

   Project assets and publication state are centralized in

   src/data/projects.ts.

   ============================================================ */

import { projects } from '@/data/projects';
import { getProjectPresentation } from '@/data/projectPresentation';

/* ============================================================

   COMPONENT PROPS

   ============================================================ */

interface Props {

  locale: Locale;

}

const { locale } = Astro.props;

const t = useTranslations(locale);

const hero = t.hero;

/* ============================================================

   FEATURED PROJECTS

   ------------------------------------------------------------

   Homepage cards must be both published and featured.

   This keeps Work and Home controlled from the same registry.

   ============================================================ */

const featuredProjects = projects.filter(
  (project) =>
    project.status === 'published' &&
    project.featured,
);

const primaryProject = featuredProjects.find(
  (project) => project.homeSlot === 'primary',
);

const secondaryProject = featuredProjects.find(
  (project) => project.homeSlot === 'secondary',
);

const supportingLeftProject = featuredProjects.find(
  (project) => project.homeSlot === 'supporting-left',
);

const supportingRightProject = featuredProjects.find(
  (project) => project.homeSlot === 'supporting-right',
);

const primaryContent = primaryProject
  ? getProjectPresentation(locale, primaryProject)
  : null;

const secondaryContent = secondaryProject
  ? getProjectPresentation(locale, secondaryProject)
  : null;

const supportingLeftContent = supportingLeftProject
  ? getProjectPresentation(locale, supportingLeftProject)
  : null;

const supportingRightContent = supportingRightProject
  ? getProjectPresentation(locale, supportingRightProject)
  : null;

