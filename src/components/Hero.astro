---
// src/components/Hero.astro
import { useTranslations, localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props { 
  locale: Locale; 
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="relative isolate flex min-h-152 items-center overflow-hidden bg-midnight sm:min-h-180 lg:min-h-216">

  <!-- Fallback Gradient Background -->
  <div
    class="absolute inset-0 -z-20 bg-linear-to-br from-midnight to-slate"
    aria-hidden="true"
  ></div>

  <!-- Readability Overlay (Stronger on the left) -->
  <div
    class="absolute inset-0 -z-10 bg-linear-to-r from-black/85 via-black/55 to-black/35"
    aria-hidden="true"
  ></div>

  <!-- Hero Content -->
  <div class="mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="max-w-2xl">

      <!-- Main Heading -->
      <h1
        class="text-4xl font-light leading-tight tracking-tight text-white sm:text-5xl lg:text-7xl lg:leading-[1.08]"
        set:html={t.hero.title}
      />

      <!-- Subtitle -->
      {t.hero.subtitle && (
        <p class="mt-6 max-w-xl font-editorial-body text-base font-normal leading-relaxed text-white/85 sm:text-lg">
          {t.hero.subtitle}
        </p>
      )}

      <!-- CTA Button -->
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={localizePath(locale, '/contact')}
          class="inline-flex items-center justify-center rounded-md bg-accent px-8 py-3.5 font-editorial-body text-xs font-semibold uppercase tracking-widest text-white shadow-xs transition-all hover:bg-accent/90 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent active:scale-[0.99]"
        >
          {t.hero.cta}
        </a>
      </div>

    </div>
  </div>

</section>