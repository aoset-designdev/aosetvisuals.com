---
/**
 * Work Intro
 *
 * Editorial introduction for the Selected Work page.
 *
 * This component is intentionally presentational.
 * Localization and content selection remain the responsibility
 * of the parent route.
 */

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
}

const {
  eyebrow,
  heading,
  intro,
} = Astro.props;
---

<section
  class="
    mx-auto
    max-w-7xl
    px-4
    pt-20
    pb-14
    sm:px-6
    sm:pt-24
    sm:pb-16
    lg:px-8
    lg:pt-28
    lg:pb-20
  "
>
  <p
    class="
      font-editorial-body
      text-[0.65rem]
      font-medium
      uppercase
      tracking-[0.24em]
      text-white/40
    "
  >
    {eyebrow}
  </p>

  <h1
    class="
      mt-5
      max-w-[13ch]
      text-4xl
      font-light
      leading-[1.03]
      tracking-[-0.035em]
      text-white
      sm:text-5xl
      lg:text-6xl
    "
  >
    {heading}
  </h1>

  <p
    class="
      mt-6
      max-w-2xl
      font-editorial-body
      text-base
      leading-relaxed
      text-white/60
      sm:text-lg
    "
  >
    {intro}
  </p>
</section>