---
/**
 * Project Card
 *
 * Reusable presentation component for entries in the
 * Selected Work project grid.
 *
 * Project data, localization and routing are resolved
 * by the parent page before reaching this component.
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  image: ImageMetadata;
  alt: string;
  label: string;
  title: string;
  subtitle?: string;
  meta: string;
  viewProject: string;
  eager?: boolean;
}

const {
  href,
  image,
  alt,
  label,
  title,
  subtitle = '',
  meta,
  viewProject,
  eager = false,
} = Astro.props;
---

<a
  href={href}
  class="
    work-card
    group
    relative
    isolate
    min-h-[28rem]
    overflow-hidden
    rounded-2xl
    border
    border-white/10
    bg-white/[0.03]
    sm:min-h-[32rem]
    lg:min-h-[36rem]
  "
>
  <Image
    src={image}
    alt={alt}
    widths={[640, 960, 1280]}
    sizes="
      (min-width: 768px) 50vw,
      100vw
    "
    loading={eager ? 'eager' : 'lazy'}
    quality={85}
    class="
      work-card-image
      absolute
      inset-0
      size-full
      object-cover
    "
  />

  <!-- Image protection -->
  <div
    class="
      absolute
      inset-0
      bg-linear-to-t
      from-midnight/95
      via-midnight/30
      to-transparent
    "
    aria-hidden="true"
  ></div>

  <!-- Project information -->
  <div
    class="
      relative
      z-10
      flex
      h-full
      flex-col
      justify-between
      p-6
      sm:p-8
    "
  >
    <p
  class="
    font-editorial-body
    text-[0.72rem]
    font-semibold
    uppercase
    tracking-[0.18em]
    text-white/80
    sm:text-[0.62rem]
    sm:font-medium
    sm:tracking-[0.22em]
    sm:text-white/55
  "
>
  {label}
</p>

    <div>
      <h2
        class="
          text-3xl
          font-light
          tracking-[-0.035em]
          text-white
          sm:text-4xl
        "
      >
        {title}
      </h2>

      {
        subtitle && (
          <p
            class="
              mt-2
              font-editorial-body
              text-sm
              text-white/70
            "
          >
            {subtitle}
          </p>
        )
      }

      <div
        class="
          mt-5
          flex
          items-end
          justify-between
          gap-6
        "
      >
        <p
  class="
    max-w-sm
    font-editorial-body
    text-sm
    leading-relaxed
    text-white/70
  "
>
  {meta}
</p>

        <span
          class="
            work-arrow
            grid
            size-10
            shrink-0
            place-items-center
            rounded-full
            border
            border-white/25
            text-white
          "
          aria-hidden="true"
        >
          →
        </span>
      </div>

      <p
        class="
          mt-5
          font-editorial-body
          text-xs
          font-medium
          uppercase
          tracking-[0.16em]
          text-white/75
        "
      >
        {viewProject}
      </p>
    </div>
  </div>
</a>

<style>
  /* =========================================================
     PROJECT CARD
     ========================================================= */

  .work-card {
    backface-visibility: hidden;
    transform: translateZ(0);
    transition:
      transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 350ms ease,
      box-shadow 350ms ease;
  }

  /* =========================================================
     PROJECT IMAGE
     ========================================================= */

  .work-card-image {
    transition:
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* =========================================================
     ACTION ARROW
     ========================================================= */

  .work-arrow {
    transition:
      transform 300ms ease,
      border-color 300ms ease,
      background-color 300ms ease;
  }

  /* =========================================================
     HOVER
     ========================================================= */

  @media (hover: hover) and (pointer: fine) {
    .work-card:hover {
      transform: translateY(-3px);
      border-color: rgb(255 255 255 / 0.16);
      box-shadow:
        0 20px 55px rgb(0 0 0 / 0.2);
    }

    .work-card:hover .work-card-image {
      transform: scale(1.025);
    }

    .work-card:hover .work-arrow {
      transform: translateX(2px);
      border-color: rgb(255 255 255 / 0.45);
      background-color: rgb(255 255 255 / 0.06);
    }
  }

  /* =========================================================
     REDUCED MOTION
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .work-card,
    .work-card-image,
    .work-arrow {
      transition: none;
    }

    .work-card:hover,
    .work-card:hover .work-card-image,
    .work-card:hover .work-arrow {
      transform: none;
    }
  }
</style>
