---
// src/components/AboutBanner.astro
import { Image } from 'astro:assets';
import bannerImage from '@/assets/about/about-banner.webp';
---

<!-- Updated aspect-[980/650] to modern aspect-980/650 syntax -->
<section class="relative w-full overflow-hidden aspect-980/650">
  <Image
    src={bannerImage}
    alt="AOSET team and media production setup"
    class="h-full w-full object-cover"
    widths={[640, 980, 1851]}
    sizes="100vw"
    format="avif"
    quality={85}
    loading="eager"
    fetchpriority="high"
  />
</section>